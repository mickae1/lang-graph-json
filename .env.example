# Copy to .env (never committed) to run the live tests:  pytest -m live -v
# The live tests are skipped when no credentials are available.

# Option 1 — Anthropic API key (Claude)
ANTHROPIC_API_KEY=
# Model used by the live tests (default: claude-haiku-5-5)
# LGJ_TEST_MODEL=claude-haiku-5-5
# Optional custom endpoint (gateway / proxy compatible with the Anthropic API)
# ANTHROPIC_BASE_URL=

# Option 2 — any provider, as the JSON body of POST /config/provider
# (takes precedence over option 1), e.g. Azure AD or a local Ollama:
# LGJ_TEST_PROVIDER_JSON={"type": "ollama", "endpoint": "http://127.0.0.1:11434", "default_model": "llama3.1"}

# Development with `langgraph dev` / LangGraph Studio (see langgraph_json/agent.py:make_graph)
# LGJ_CONFIG_DIR=config
# LGJ_MODEL=claude-sonnet-5-5
